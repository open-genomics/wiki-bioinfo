{
  "name": "wiki-bioinfo",
  "version": "1.0.0",
  "description": "面向中文社区的生物信息学体系化知识库",
  "private": true,
  "type": "module",
  "author": "holtwood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-genomics/wiki-bioinfo.git"
  },
  "bugs": {
    "url": "https://github.com/open-genomics/wiki-bioinfo/issues"
  },
  "homepage": "https://open-genomics.github.io/wiki-bioinfo/",
  "keywords": [
    "bioinformatics",
    "wiki",
    "knowledge-base",
    "chinese",
    "astro",
    "starlight",
    "documentation"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fonts:subset": "python3 scripts/subset-fonts.py",
    "check": "npm run check:fonts && astro check && astro build && npm run check:head && npm run check:rendered",
    "check:fonts": "node scripts/checks/check-font-coverage.mjs",
    "check:links": "bash scripts/checks/check-links.sh",
    "check:head": "node scripts/checks/check-head-meta.mjs",
    "check:rendered": "node scripts/checks/check-rendered-links.mjs",
    "clean": "rm -rf dist .astro",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/starlight": "^0.38.3",
    "astro": "^6.1.7",
    "katex": "^0.16.45",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=22.0"
  }
}
