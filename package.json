{
  "name": "wiki-bioinfo",
  "version": "1.0.0",
  "description": "面向中文社区的生物信息学体系化知识库",
  "private": true,
  "type": "module",
  "author": "holtwood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/holtwood-genomics/wiki-bioinfo.git"
  },
  "bugs": {
    "url": "https://github.com/holtwood-genomics/wiki-bioinfo/issues"
  },
  "homepage": "https://holtwood-genomics.github.io/wiki-bioinfo/",
  "keywords": [
    "bioinformatics",
    "wiki",
    "knowledge-base",
    "chinese",
    "astro",
    "starlight",
    "documentation"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fonts:subset": "python3 scripts/subset-fonts.py",
    "check": "npm run check:fonts && npm run check:tables && astro check && astro build && npm run check:head && npm run check:rendered",
    "check:fonts": "node scripts/checks/check-font-coverage.mjs",
    "check:links": "bash scripts/checks/check-links.sh",
    "check:head": "node scripts/checks/check-head-meta.mjs",
    "check:rendered": "node scripts/checks/check-rendered-links.mjs",
    "clean": "rm -rf dist .astro",
    "astro": "astro",
    "check:tables": "node scripts/checks/check-data-tables.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.12",
    "katex": "^0.18.10",
    "satteri": "0.11.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
