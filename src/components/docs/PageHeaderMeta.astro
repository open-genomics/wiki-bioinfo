---
/**
 * PageHeaderMeta - 页面头部元信息组件
 *
 * 自动从页面路径推断所属板块（section），无需显式传入。
 * 保留 audience / startWith / prereqs / estimatedTime / difficulty
 * 供板块入口页等需要丰富阅读引导的页面使用。
 */
interface Props {
  audience?: string;
  startWith?: string;
  prereqs?: string[];
  estimatedTime?: string;
  difficulty?: string;
}

import { Icon } from '@astrojs/starlight/components';
import { getSectionFromSlug, getSectionMeta } from '@/data/sections';

const {
  audience,
  startWith,
  prereqs = [],
  estimatedTime,
  difficulty,
} = Astro.props;

// 从路径自动推断 section
const slug = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '')
  .replace(/\/$/, '')
  .replace(/^\//, '');
const sectionId = getSectionFromSlug(slug);
const sectionMeta = sectionId ? getSectionMeta(sectionId) : undefined;

const primaryValue = sectionMeta?.label ?? 'BioInfo Wiki';
const primaryDetail = sectionMeta?.description
  ?? '帮助你快速判断当前主题与全站知识图谱的连接方式。';

const hasAudience = Boolean(audience);
const hasReadingMeta = Boolean(estimatedTime || difficulty);
const hasPathInfo = Boolean(startWith || prereqs.length > 0);

// 卡片 2：阅读引导或板块描述
const secondaryLabel = hasAudience
  ? '适合谁读'
  : hasReadingMeta
    ? '阅读信息'
    : '阅读目标';

const secondaryValue = hasAudience
  ? '建议在以下阶段阅读'
  : difficulty
    ? `难度：${difficulty}`
    : estimatedTime
      ? '阅读时长'
      : '帮助建立阅读上下文';

const secondaryDetail = hasAudience
  ? audience!
  : estimatedTime && difficulty
    ? `预计阅读：${estimatedTime}`
    : estimatedTime
      ? `预计阅读：${estimatedTime}`
      : difficulty
        ? `内容难度：${difficulty}`
        : '先判断这页与你当前问题的关系，再决定是否深入展开。';

// 卡片 3：路径信息或阅读元信息
const pathDetail = startWith
  ? (prereqs.length > 0 ? `${startWith}；相关前置：${prereqs.join('、')}` : startWith)
  : (prereqs.length > 0 ? `相关前置：${prereqs.join('、')}` : '');

const tertiaryLabel = hasPathInfo
  ? (startWith ? '建议起点' : '建议前置')
  : hasReadingMeta && hasAudience
    ? '阅读信息'
    : '建议前置';

const tertiaryValue = hasPathInfo
  ? (startWith ? '推荐阅读路径' : '建议先准备相关前置')
  : hasReadingMeta
    ? (difficulty ? `难度：${difficulty}` : '阅读时长')
    : '先建立相关基础对象与方法直觉';

const tertiaryDetail = hasPathInfo
  ? pathDetail
  : estimatedTime && difficulty
    ? `预计阅读：${estimatedTime}`
    : estimatedTime
      ? `预计阅读：${estimatedTime}`
      : difficulty
        ? `内容难度：${difficulty}`
        : '建议先建立相关基础对象与方法直觉，再进入本页。';

const cards = [
  {
    icon: 'list-format',
    label: sectionMeta ? '所属板块' : '当前主题',
    value: primaryValue,
    detail: primaryDetail,
  },
  {
    icon: hasAudience ? 'random' : 'document',
    label: secondaryLabel,
    value: secondaryValue,
    detail: secondaryDetail,
  },
  {
    icon: hasPathInfo ? 'right-arrow' : 'document',
    label: tertiaryLabel,
    value: tertiaryValue,
    detail: tertiaryDetail,
  },
] as const;

---

<div class="header-meta-grid not-content">
  {cards.map((card) => (
    <section class="header-meta-card">
      <span class="meta-label"><Icon name={card.icon} size="1rem" /> {card.label}</span>
      <strong class="meta-value">{card.value}</strong>
      <p class="meta-detail">{card.detail}</p>
    </section>
  ))}
</div>
