---
/**
 * PageHeaderMeta - 页面头部元信息组件
 *
 * 自动从页面路径推断所属板块（section），无需显式传入。
 * 只渲染有真实元信息的卡片；无内容的卡片不显示，避免占位废话。
 */
interface Props {
  audience?: string;
  startWith?: string;
  prereqs?: string[];
  estimatedTime?: string;
  difficulty?: string;
}

import { Icon } from '@astrojs/starlight/components';
import { getSectionFromSlug, getSectionMeta } from '@/data/sections';

const {
  audience,
  startWith,
  prereqs = [],
  estimatedTime,
  difficulty,
} = Astro.props;

// 从路径自动推断 section
const slug = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '')
  .replace(/\/$/, '')
  .replace(/^\//, '');
const sectionId = getSectionFromSlug(slug);
const sectionMeta = sectionId ? getSectionMeta(sectionId) : undefined;

type HeaderMetaIcon = 'list-format' | 'random' | 'document' | 'right-arrow';

interface HeaderMetaCard {
  icon: HeaderMetaIcon;
  label: string;
  value: string;
  detail: string;
}

/**
 * 构建头部元信息卡片。只返回有真实内容的卡片，无内容则省略。
 * 卡片顺序：板块 → 适合谁读 → 阅读信息 → 阅读路径。
 */
function buildPageHeaderCards(input: {
  sectionMeta?: { label: string; description: string };
  audience?: string | undefined;
  startWith?: string | undefined;
  prereqs: string[];
  estimatedTime?: string | undefined;
  difficulty?: string | undefined;
}): HeaderMetaCard[] {
  const cards: HeaderMetaCard[] = [];

  // 卡片 1：板块信息（仅当能推断出 section 时）
  if (input.sectionMeta) {
    cards.push({
      icon: 'list-format',
      label: '所属板块',
      value: input.sectionMeta.label,
      detail: input.sectionMeta.description,
    });
  }

  // 卡片 2：适合谁读（仅当提供 audience）
  if (input.audience) {
    cards.push({
      icon: 'random',
      label: '适合谁读',
      value: '建议在以下阶段阅读',
      detail: input.audience,
    });
  }

  // 卡片 3：阅读信息（仅当提供 estimatedTime 或 difficulty）
  if (input.estimatedTime || input.difficulty) {
    const parts: string[] = [];
    if (input.estimatedTime) parts.push(`预计阅读：${input.estimatedTime}`);
    if (input.difficulty) parts.push(`难度：${input.difficulty}`);
    cards.push({
      icon: 'document',
      label: '阅读信息',
      value: input.difficulty ? `难度：${input.difficulty}` : '阅读时长',
      detail: parts.join('；'),
    });
  }

  // 卡片 4：阅读路径（仅当提供 startWith 或 prereqs）
  if (input.startWith || input.prereqs.length > 0) {
    const detailParts: string[] = [];
    if (input.startWith) detailParts.push(input.startWith);
    if (input.prereqs.length > 0) {
      detailParts.push(`相关前置：${input.prereqs.join('、')}`);
    }
    cards.push({
      icon: 'right-arrow',
      label: input.startWith ? '建议起点' : '建议前置',
      value: input.startWith ? '推荐阅读路径' : '建议先准备相关前置',
      detail: detailParts.join('；'),
    });
  }

  return cards;
}

const cards = buildPageHeaderCards({
  ...(sectionMeta
    ? { sectionMeta: { label: sectionMeta.label, description: sectionMeta.description } }
    : {}),
  audience,
  startWith,
  prereqs,
  estimatedTime,
  difficulty,
});
---

{cards.length > 0 && (
  <div class="header-meta-grid not-content">
    {cards.map((card) => (
      <section class="header-meta-card">
        <span class="meta-label"><Icon name={card.icon} size="1rem" /> {card.label}</span>
        <strong class="meta-value">{card.value}</strong>
        <p class="meta-detail">{card.detail}</p>
      </section>
    ))}
  </div>
)}
