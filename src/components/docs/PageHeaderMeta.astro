---
/**
 * PageHeaderMeta - 页面头部元信息组件
 *
 * 自动从页面路径推断所属板块（section），无需显式传入。
 * 只渲染有真实元信息的卡片；无内容的卡片不显示，避免占位废话。
 */
interface Props {
  audience?: string;
  startWith?: string;
}

import { Icon } from '@astrojs/starlight/components';
import { getSectionFromSlug, getSectionMeta } from '@/data/sections';
import { stripBase } from './link-utils';

const { audience, startWith } = Astro.props;

// 从路径自动推断 section
const slug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL);
const sectionId = getSectionFromSlug(slug);
const sectionMeta = sectionId ? getSectionMeta(sectionId) : undefined;

type HeaderMetaIcon = 'list-format' | 'random' | 'right-arrow';

interface HeaderMetaCard {
  icon: HeaderMetaIcon;
  label: string;
  value: string;
  detail: string;
}

/**
 * 构建头部元信息卡片。只返回有真实内容的卡片，无内容则省略。
 * 卡片顺序：板块 → 适合谁读 → 阅读路径。
 */
function buildPageHeaderCards(input: {
  sectionMeta?: { label: string; description: string };
  audience?: string | undefined;
  startWith?: string | undefined;
}): HeaderMetaCard[] {
  const cards: HeaderMetaCard[] = [];

  // 卡片 1：板块信息（仅当能推断出 section 时）
  if (input.sectionMeta) {
    cards.push({
      icon: 'list-format',
      label: '所属板块',
      value: input.sectionMeta.label,
      detail: input.sectionMeta.description,
    });
  }

  // 卡片 2：适合谁读（仅当提供 audience）
  if (input.audience) {
    cards.push({
      icon: 'random',
      label: '适合谁读',
      value: '建议在以下阶段阅读',
      detail: input.audience,
    });
  }

  // 卡片 3：阅读路径（仅当提供 startWith）
  if (input.startWith) {
    cards.push({
      icon: 'right-arrow',
      label: '建议起点',
      value: '推荐阅读路径',
      detail: input.startWith,
    });
  }

  return cards;
}

const cards = buildPageHeaderCards({
  ...(sectionMeta
    ? { sectionMeta: { label: sectionMeta.label, description: sectionMeta.description } }
    : {}),
  audience,
  startWith,
});
---

{cards.length > 0 && (
  <div class="header-meta-grid not-content">
    {cards.map((card) => (
      <section class="header-meta-card">
        <span class="meta-label"><Icon name={card.icon} size="1rem" /> {card.label}</span>
        <strong class="meta-value">{card.value}</strong>
        <p class="meta-detail">{card.detail}</p>
      </section>
    ))}
  </div>
)}
