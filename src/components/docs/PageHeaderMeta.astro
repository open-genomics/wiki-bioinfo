---
/**
 * PageHeaderMeta - 页面头部元信息组件
 *
 * 自动从页面路径推断所属板块（section），无需显式传入。
 * 保留 audience / startWith / prereqs / estimatedTime / difficulty
 * 供板块入口页等需要丰富阅读引导的页面使用。
 */
interface Props {
  audience?: string;
  startWith?: string;
  prereqs?: string[];
  estimatedTime?: string;
  difficulty?: string;
}

import { Icon } from '@astrojs/starlight/components';
import { getSectionFromSlug, getSectionMeta } from '@/data/sections';

const {
  audience,
  startWith,
  prereqs = [],
  estimatedTime,
  difficulty,
} = Astro.props;

// 从路径自动推断 section
const slug = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '')
  .replace(/\/$/, '')
  .replace(/^\//, '');
const sectionId = getSectionFromSlug(slug);
const sectionMeta = sectionId ? getSectionMeta(sectionId) : undefined;

type HeaderMetaIcon = 'list-format' | 'random' | 'document' | 'right-arrow';

const cards = buildPageHeaderCards({
  ...(sectionMeta
    ? { sectionMeta: { label: sectionMeta.label, description: sectionMeta.description } }
    : {}),
  audience,
  startWith,
  prereqs,
  estimatedTime,
  difficulty,
});

function buildPageHeaderCards(input: {
  sectionMeta?: { label: string; description: string } | undefined;
  audience?: string | undefined;
  startWith?: string | undefined;
  prereqs?: string[] | undefined;
  estimatedTime?: string | undefined;
  difficulty?: string | undefined;
}): { icon: HeaderMetaIcon; label: string; value: string; detail: string }[] {
  const hasAudience = Boolean(input.audience);
  const hasReadingMeta = Boolean(input.estimatedTime || input.difficulty);
  const prereqs = input.prereqs ?? [];
  const hasPathInfo = Boolean(input.startWith || prereqs.length > 0);

  // 卡片 1：板块信息
  const primaryValue = input.sectionMeta?.label ?? 'BioInfo Wiki';
  const primaryDetail =
    input.sectionMeta?.description ??
    '帮助你快速判断当前主题与全站知识图谱的连接方式。';

  // 卡片 2：阅读引导或板块描述
  const secondaryLabel = hasAudience
    ? '适合谁读'
    : hasReadingMeta
      ? '阅读信息'
      : '阅读目标';

  const secondaryValue = hasAudience
    ? '建议在以下阶段阅读'
    : input.difficulty
      ? `难度：${input.difficulty}`
      : input.estimatedTime
        ? '阅读时长'
        : '帮助建立阅读上下文';

  const secondaryDetail = hasAudience
    ? input.audience!
    : input.estimatedTime && input.difficulty
      ? `预计阅读：${input.estimatedTime}`
      : input.estimatedTime
        ? `预计阅读：${input.estimatedTime}`
        : input.difficulty
          ? `内容难度：${input.difficulty}`
          : '先判断这页与你当前问题的关系，再决定是否深入展开。';

  // 卡片 3：路径信息或阅读元信息
  const pathDetail = input.startWith
    ? prereqs.length > 0
      ? `${input.startWith}；相关前置：${prereqs.join('、')}`
      : input.startWith
    : prereqs.length > 0
      ? `相关前置：${prereqs.join('、')}`
      : '';

  const tertiaryLabel = hasPathInfo
    ? input.startWith
      ? '建议起点'
      : '建议前置'
    : hasReadingMeta && hasAudience
      ? '阅读信息'
      : '建议前置';

  const tertiaryValue = hasPathInfo
    ? input.startWith
      ? '推荐阅读路径'
      : '建议先准备相关前置'
    : hasReadingMeta
      ? input.difficulty
        ? `难度：${input.difficulty}`
        : '阅读时长'
      : '先建立相关基础对象与方法直觉';

  const tertiaryDetail = hasPathInfo
    ? pathDetail
    : input.estimatedTime && input.difficulty
      ? `预计阅读：${input.estimatedTime}`
      : input.estimatedTime
        ? `预计阅读：${input.estimatedTime}`
        : input.difficulty
          ? `内容难度：${input.difficulty}`
          : '建议先建立相关基础对象与方法直觉，再进入本页。';

  return [
    {
      icon: 'list-format',
      label: input.sectionMeta ? '所属板块' : '当前主题',
      value: primaryValue,
      detail: primaryDetail,
    },
    {
      icon: hasAudience ? 'random' : 'document',
      label: secondaryLabel,
      value: secondaryValue,
      detail: secondaryDetail,
    },
    {
      icon: hasPathInfo ? 'right-arrow' : 'document',
      label: tertiaryLabel,
      value: tertiaryValue,
      detail: tertiaryDetail,
    },
  ];
}

---

<div class="header-meta-grid not-content">
  {cards.map((card) => (
    <section class="header-meta-card">
      <span class="meta-label"><Icon name={card.icon} size="1rem" /> {card.label}</span>
      <strong class="meta-value">{card.value}</strong>
      <p class="meta-detail">{card.detail}</p>
    </section>
  ))}
</div>
