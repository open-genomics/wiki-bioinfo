---
interface Props {
  title?: string;
  items?: Array<string | {
    name?: string;
    title?: string;
    label?: string;
    text?: string;
    href?: string;
    to?: string;
  }>;
}

import { Icon } from '@astrojs/starlight/components';
import { resolvePrereqItems } from './link-utils';

const { title = '前置知识', items = [] } = Astro.props;
const resolvedItems = resolvePrereqItems(items, import.meta.env.BASE_URL);
---

<aside class="note-card">
  <strong><Icon name="open-book" size="1.2rem" /> {title}</strong>
  {resolvedItems.length > 0 && (
    <ul>
      {resolvedItems.map((item) => (
        <li>
          {item.href ? (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          ) : item.label}
        </li>
      ))}
    </ul>
  )}
  <slot />
</aside>
