---
import StarlightHead from '@astrojs/starlight/components/Head.astro';
import { siteConfig, siteUrl, ogImageUrl } from '@/data/site-config';
import { stripBase } from '@/components/docs/link-utils';

// Page.astro 渲染 <Head /> 时不传 props，页面级数据需从 Starlight 路由上下文读取
const { entry } = Astro.locals.starlightRoute;
const pageTitle = entry.data.title;
const pageDescription = entry.data.description || siteConfig.description;

// 仅首页注入 WebSite 结构化数据；通用 meta 由 Starlight 自身输出，这里只补它没有的标签
const slug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL);
const isHomePage = slug === '';

const structuredData = isHomePage
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      url: siteUrl,
      description: pageDescription,
      inLanguage: siteConfig.locale,
    }
  : null;
---

<StarlightHead {...Astro.props}>
  <slot />
</StarlightHead>

<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={siteConfig.title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImageUrl} />

<meta name="author" content={siteConfig.title} />
<meta
  name="keywords"
  content={siteConfig.keywords}
/>
<meta name="theme-color" content={siteConfig.themeColor} />

{structuredData && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  />
)}
